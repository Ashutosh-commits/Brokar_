# ─── Root .env.example ────────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# API URL baked into the React bundle at build time.
# In Docker, set this to your public API domain, e.g. https://api.yourdomain.com/api
VITE_API_URL=http://localhost:3001/api

# Redis cache password (used by docker-compose)
# Generate: openssl rand -hex 20
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Postgres password (used by docker-compose and server/.env DATABASE_URL)
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# JWT secrets — generate separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX

# Groq AI key (free at https://console.groq.com) — server-side only
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY

# Shared secret between Express and the scraper service
SCRAPER_API_KEY=REPLACE_WITH_RANDOM_32_CHAR_HEX

# Public URL of your frontend (used by CORS and password-reset links)
CLIENT_URL=http://localhost:3000
