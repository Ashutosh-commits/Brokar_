# ─── server/.env — copy this file to server/.env and fill in real values ─────
# NEVER commit server/.env — it is in .gitignore.

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev:  postgresql://postgres:<password>@localhost:5433/brokar1
# Docker:     postgresql://postgres:<password>@postgres:5432/brokar1
# Cloud (Neon/Supabase): use the connection string from your provider
DATABASE_URL="postgresql://postgres:your_password@localhost:5433/brokar1"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Docker:    redis://redis:6379
REDIS_URL="redis://localhost:6379"

# ─── JWT secrets ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
REFRESH_SECRET=""

# ─── Groq AI (free) ───────────────────────────────────────────────────────────
# Get your key at https://console.groq.com
# ⚠️  This must ONLY be in server/.env — never in the root .env or any VITE_ var
GROQ_API_KEY=""

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS: comma-separated list of allowed frontend origins ──────────────────
CLIENT_URL="http://localhost:5173,http://localhost:3000"

# ─── ML and Scraper service URLs ─────────────────────────────────────────────
# Local dev: use localhost; Docker: use container names (ml-service / scraper)
ML_SERVICE_URL=http://localhost:8000
SCRAPER_SERVICE_URL=http://localhost:8001
SCRAPER_API_KEY=""

# ─── Optional ─────────────────────────────────────────────────────────────────
# RATE_LIMIT_MAX=200   # requests per 15 min window (default: 200 prod / 1000 dev)
