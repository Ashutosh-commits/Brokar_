# ─── scraper/.env — copy this file to scraper/.env and fill in real values ───
# NEVER commit scraper/.env — it is in .gitignore.

# ─── Shared secret between the Express server and the scraper ────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Must match SCRAPER_API_KEY in server/.env
SCRAPER_API_KEY=""

# ─── Scraper FastAPI bind address ────────────────────────────────────────────
SCRAPER_SERVICE_URL=http://localhost:8001
